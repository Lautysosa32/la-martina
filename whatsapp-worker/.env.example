# Variables de conexión para el Worker local de WhatsApp
SUPABASE_URL=https://your-project-id.supabase.co

# Opción A (Recomendada): Usar la service_role key de Supabase (Bypass RLS)
# Se copia desde: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Opción B: Usar clave anónima (Requiere ejecutar supabase_fix_whatsapp_worker.sql en Supabase)
SUPABASE_KEY=tu-supabase-anon-key

# Opción C: Autenticación como empleado (opcional)
# WORKER_EMAIL=empleado@lamartina.com
# WORKER_PASSWORD=contraseña
